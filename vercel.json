{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "routes": [
    {
      "src": "/(dashboard|admin|login)(/.*)?",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "continue": true
    },
    {
      "src": "/ai-receptionist-for-small-business/?",
      "dest": "/ai-receptionist-for-small-business/index.html"
    },
    {
      "src": "/ai-receptionist-for-plumbers/?",
      "dest": "/ai-receptionist-for-plumbers/index.html"
    },
    {
      "src": "/ai-receptionist-for-salons/?",
      "dest": "/ai-receptionist-for-salons/index.html"
    },
    {
      "src": "/ai-receptionist-for-clinics/?",
      "dest": "/ai-receptionist-for-clinics/index.html"
    },
    {
      "src": "/ai-receptionist-for-law-firms/?",
      "dest": "/ai-receptionist-for-law-firms/index.html"
    },
    {
      "src": "/missed-call-lead-capture/?",
      "dest": "/missed-call-lead-capture/index.html"
    },
    {
      "src": "/ai-appointment-booking/?",
      "dest": "/ai-appointment-booking/index.html"
    },
    {
      "src": "/blog/?",
      "dest": "/blog/index.html"
    },
    {
      "src": "/blog/after-hours-call-answering-service/?",
      "dest": "/blog/after-hours-call-answering-service/index.html"
    },
    {
      "src": "/blog/ai-phone-answering-service-for-service-businesses/?",
      "dest": "/blog/ai-phone-answering-service-for-service-businesses/index.html"
    },
    {
      "src": "/blog/ai-receptionist-cost/?",
      "dest": "/blog/ai-receptionist-cost/index.html"
    },
    {
      "src": "/blog/free-ai-receptionist-small-business/?",
      "dest": "/blog/free-ai-receptionist-small-business/index.html"
    },
    {
      "src": "/blog/ai-receptionist-vs-human-receptionist/?",
      "dest": "/blog/ai-receptionist-vs-human-receptionist/index.html"
    },
    {
      "src": "/blog/best-ai-receptionist-small-business-usa/?",
      "dest": "/blog/best-ai-receptionist-small-business-usa/index.html"
    },
    {
      "src": "/pricing/?",
      "dest": "/pricing/index.html"
    },
    {
      "src": "/get-started/?",
      "dest": "/get-started/index.html"
    },
    {
      "src": "/contact/?",
      "dest": "/contact/index.html"
    },
    {
      "src": "/terms/?",
      "dest": "/terms/index.html"
    },
    {
      "src": "/privacy/?",
      "dest": "/privacy/index.html"
    },
    {
      "src": "/login/?",
      "dest": "/login/index.html"
    },
    {
      "src": "/dashboard/?",
      "dest": "/index.html"
    },
    {
      "src": "/admin/?",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
